{
  "runtime": "claude-code",
  "manifestVersion": 1,
  "loopId": "seo-growth",
  "version": 1,
  "skills": ["seo-growth-loop"],
  "triggers": [
    { "type": "manual", "enabled": false, "role": "primary" },
    { "type": "webhook", "enabled": false, "role": "primary", "external": true },
    { "type": "cron", "enabled": false, "role": "primary", "external": true, "schedule": "0 8 * * 1" }
  ],
  "approvalRequired": true,
  "alertPolicy": "on-failure",
  "target": { "metric": "qualified_leads", "desired": 40, "direction": "at-least", "horizonDays": 90 },
  "feedback": [{ "metric": "qualified_leads", "delayDays": 30 }],
  "guardrails": [],
  "serviceLevels": [],
  "promptCycle": {
    "entry": {
      "executable": "loopstack",
      "args": ["prompt-cycle", "run", "--loop", "loops/seo-growth"]
    },
    "requestContract": "AgentRunRequest",
    "resultContract": "AgentRunResult",
    "decisions": ["continue", "wait-human", "wait-external", "stop-success", "stop-failure", "escalate"],
    "makerChecker": true
  },
  "permissions": { "allow": [] },
  "externalTriggerRequirements": [
    "webhook: invoke claude with loop id and idempotency key",
    "cron: invoke claude with loop id and idempotency key"
  ],
  "workDirectory": "loops/seo-growth"
}
