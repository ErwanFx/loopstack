{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "always",
            "conditional",
            "never"
          ],
          "type": "string"
        },
        "requiredFor": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "mode",
        "requiredFor",
        "approvers"
      ],
      "type": "object"
    },
    "current": {
      "additionalProperties": false,
      "properties": {
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "observedAt"
      ],
      "type": "object"
    },
    "feedback": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "delayDays": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "metric": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "metric",
          "delayDays"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "idea",
        "qualifying",
        "blocked",
        "designing",
        "planned",
        "awaiting-approval",
        "building",
        "qa-failed",
        "ready",
        "shadow",
        "canary",
        "active",
        "paused",
        "degraded",
        "failed",
        "inactive",
        "archived"
      ],
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "desired": {
          "type": "number"
        },
        "horizonDays": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "metric": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "desired",
        "horizonDays"
      ],
      "type": "object"
    },
    "triggers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "type": {
            "enum": [
              "manual",
              "cron",
              "webhook",
              "event",
              "queue"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "status",
    "target",
    "current",
    "triggers",
    "feedback"
  ],
  "type": "object"
}
