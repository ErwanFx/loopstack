{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gates": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "properties": {
              "approvers": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "beforeAction": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "choices": {
                "items": {
                  "enum": [
                    "approve",
                    "edit",
                    "reject",
                    "request-information"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "conditions": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "evidenceArtifacts": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "id": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "onReject": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "onTimeout": {
                "enum": [
                  "escalate",
                  "reject",
                  "pause"
                ],
                "type": "string"
              },
              "resumeFrom": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "type": "string"
              },
              "risk": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "timeoutHours": {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            },
            "required": [
              "id",
              "beforeAction",
              "risk",
              "conditions",
              "evidenceArtifacts",
              "choices",
              "approvers",
              "timeoutHours",
              "onTimeout",
              "onReject",
              "resumeFrom"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "always",
            "conditional",
            "never"
          ],
          "type": "string"
        },
        "requiredFor": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "mode",
        "requiredFor",
        "approvers",
        "gates"
      ],
      "type": "object"
    },
    "architectureShape": {
      "default": "control-loop",
      "enum": [
        "control-loop",
        "workflow-with-control-loop",
        "multi-loop-system"
      ],
      "type": "string"
    },
    "current": {
      "additionalProperties": false,
      "properties": {
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "observedAt"
      ],
      "type": "object"
    },
    "feedback": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "delayDays": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "metric": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "metric",
          "delayDays"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "guardrails": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "evaluationWindowDays": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "metric": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "onBreach": {
            "enum": [
              "pause",
              "stop",
              "escalate"
            ],
            "type": "string"
          },
          "operator": {
            "enum": [
              "lt",
              "lte",
              "eq",
              "gte",
              "gt"
            ],
            "type": "string"
          },
          "sourceOfTruth": {
            "minLength": 1,
            "type": "string"
          },
          "threshold": {
            "type": "number"
          }
        },
        "required": [
          "metric",
          "operator",
          "threshold",
          "sourceOfTruth",
          "evaluationWindowDays",
          "onBreach"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 3,
      "default": 3,
      "type": "number"
    },
    "serviceLevels": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "appliesTo": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "metric": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
            "type": "string"
          },
          "operator": {
            "enum": [
              "lt",
              "lte",
              "eq",
              "gte",
              "gt"
            ],
            "type": "string"
          },
          "threshold": {
            "type": "number"
          }
        },
        "required": [
          "metric",
          "operator",
          "threshold",
          "appliesTo"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "idea",
        "qualifying",
        "blocked",
        "designing",
        "planned",
        "awaiting-approval",
        "building",
        "qa-failed",
        "ready",
        "shadow",
        "canary",
        "active",
        "paused",
        "degraded",
        "failed",
        "inactive",
        "archived"
      ],
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "desired": {
          "type": "number"
        },
        "direction": {
          "default": "at-least",
          "enum": [
            "at-least",
            "at-most",
            "equal"
          ],
          "type": "string"
        },
        "horizonDays": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "metric": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "type": "string"
        },
        "sourceOfTruth": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "metric",
        "desired",
        "horizonDays",
        "direction"
      ],
      "type": "object"
    },
    "triggers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "debounceSeconds": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "const": false,
            "default": false,
            "type": "boolean"
          },
          "event": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "idempotencyKey": {
            "minLength": 1,
            "type": "string"
          },
          "payloadSchemaRef": {
            "minLength": 1,
            "type": "string"
          },
          "recoveryPurpose": {
            "minLength": 1,
            "type": "string"
          },
          "replayWindowHours": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "role": {
            "default": "primary",
            "enum": [
              "primary",
              "recovery",
              "watchdog",
              "resume"
            ],
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "manual",
              "cron",
              "webhook",
              "event",
              "queue"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "role",
          "enabled"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "status",
    "architectureShape",
    "target",
    "current",
    "triggers",
    "feedback",
    "guardrails",
    "serviceLevels"
  ],
  "type": "object"
}
